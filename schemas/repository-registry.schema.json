{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/repository-registry.schema.json",
  "title": "Repository Registry",
  "type": "object",
  "required": [
    "version",
    "status",
    "principle",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string"
    },
    "principle": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "description",
          "primary_repo",
          "related_repos",
          "load_rule",
          "when_to_use",
          "when_not_to_use",
          "governance_authority",
          "epistemic_support",
          "verification_status",
          "lifecycle_status",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "domain": {"type": "string"},
          "description": {"type": "string"},
          "primary_repo": {"type": ["string", "null"]},
          "related_repos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "repo",
                "relationship",
                "verification_status",
                "epistemic_support",
                "lifecycle_status"
              ],
              "additionalProperties": false,
              "properties": {
                "repo": {"type": "string"},
                "relationship": {"type": "string"},
                "verification_status": {"$ref": "#/$defs/verification_status"},
                "epistemic_support": {"$ref": "#/$defs/epistemic_support"},
                "lifecycle_status": {"$ref": "#/$defs/lifecycle_status"},
                "notes": {"type": "string"}
              }
            }
          },
          "load_rule": {"type": "string"},
          "when_to_use": {"type": "string"},
          "when_not_to_use": {"type": "string"},
          "governance_authority": {"$ref": "#/$defs/governance_authority"},
          "epistemic_support": {"$ref": "#/$defs/epistemic_support"},
          "verification_status": {"$ref": "#/$defs/verification_status"},
          "lifecycle_status": {"$ref": "#/$defs/lifecycle_status"},
          "notes": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "governance_authority": {
      "enum": ["advisory", "accepted_decision", "project_contract", "frozen_contract"]
    },
    "epistemic_support": {
      "enum": ["unsupported", "source_supported", "observed", "reproduced", "test_verified", "expert_verified"]
    },
    "verification_status": {
      "enum": ["not_checked", "statically_inspected", "source_supported", "tool_observed", "reproduced", "test_verified", "fixture_verified", "externally_reviewed", "not_verifiable", "insufficient_evidence"]
    },
    "lifecycle_status": {
      "enum": ["candidate", "active", "stale", "superseded", "deprecated", "rejected", "archived"]
    }
  }
}
